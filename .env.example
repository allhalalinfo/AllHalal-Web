# ============================================
# AllHalal.info Environment Variables
# ============================================
# Copy this to .env.local for development
# Add these to Vercel for production

# ============================================
# CRON AUTHENTICATION
# ============================================
# Secret token for /api/cron/update-news endpoint
# Generate with: openssl rand -hex 32
# Used by Hetzner cron job to authenticate requests
CRON_SECRET=your_random_secret_here_min_32_chars

# ============================================
# REDIS CACHE (Upstash - Secure REST API)
# ============================================
# Get from: https://console.upstash.com
# Free tier: 256MB, 10K commands/day (sufficient for this use case)
# 
# SECURITY: Uses HTTPS REST API (TLS encrypted), no direct TCP exposure
# Never expose Redis port directly to internet!
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ============================================
# CRON SETUP: Hetzner Server (NOT Vercel)
# ============================================
# Vercel Hobby plan: cron limited to 1/day
# Solution: Use Hetzner server cron (runs every 30 minutes)
#
# On your Hetzner server:
# crontab -e
# Add: */30 * * * * curl -H "Authorization: Bearer YOUR_CRON_SECRET" https://allhalal.info/api/cron/update-news >> /var/log/allhalal-cron.log 2>&1

# ============================================
# AI SERVICES (Optional - Week 3+)
# ============================================
# Only needed if you add AI summaries later
# Leave empty for now

# DeepSeek API (cheapest option)
# Get from: https://platform.deepseek.com
# DEEPSEEK_API_KEY=your_key_here

# Moonshot/Kimi API (alternative)
# Get from: https://platform.moonshot.ai
# MOONSHOT_API_KEY=your_key_here

# ============================================
# SETUP CHECKLIST
# ============================================
# Week 1, Day 1-2:
# [x] Set CRON_SECRET
# [x] Create Upstash Redis (free tier)
# [x] Set UPSTASH_REDIS_REST_URL + TOKEN
# [ ] Test locally: http://localhost:3000/api/cron/update-news
# [ ] Deploy to Vercel
# [ ] Setup Hetzner cron (see above)
# [ ] Monitor logs: /var/log/allhalal-cron.log

# Week 3+ (optional):
# [ ] Add DEEPSEEK_API_KEY for AI summaries
# [ ] Test AI integration locally
# [ ] Monitor costs

# ============================================
# NOTES
# ============================================
# - Upstash uses HTTPS REST API (secure by default)
# - If Upstash not configured, falls back to in-memory cache
# - Memory cache is reset on every Vercel deployment
# - Redis cache survives deployments and is shared across serverless instances
#
# SECURITY:
# - Never use direct Redis TCP connections from Vercel (insecure)
# - Upstash REST API uses TLS encryption
# - CRON_SECRET protects endpoint from unauthorized access
