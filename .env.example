# ============================================
# AllHalal.info Environment Variables
# ============================================
# Copy this to .env.local for development
# Add these to Vercel for production

# ============================================
# CRON AUTHENTICATION
# ============================================
# Secret token for /api/cron/update-news endpoint
# Generate with: openssl rand -hex 32
# Used by Hetzner cron job to authenticate requests
CRON_SECRET=your_random_secret_here_min_32_chars

# ============================================
# REDIS CACHE (Choose ONE option)
# ============================================

# OPTION 1: Hetzner Redis (Recommended - $0, you already have it)
# Format: redis://[username]:password@host:port
# Example: redis://:mypassword@123.456.789.0:6379
HETZNER_REDIS_URL=redis://your-hetzner-ip:6379
HETZNER_REDIS_PASSWORD=your-redis-password

# OPTION 2: Upstash Redis (Fallback - free tier, managed)
# Get from: https://console.upstash.com
# Used automatically if HETZNER_REDIS_URL is not set
UPSTASH_REDIS_URL=https://your-region.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token

# ============================================
# AI SERVICES (Optional - Week 3+)
# ============================================
# Only needed if you add AI summaries later
# Leave empty for now

# DeepSeek API (cheapest option)
# Get from: https://platform.deepseek.com
# DEEPSEEK_API_KEY=your_key_here

# Moonshot/Kimi API (alternative)
# Get from: https://platform.moonshot.ai
# MOONSHOT_API_KEY=your_key_here

# ============================================
# SETUP CHECKLIST
# ============================================
# Week 1, Day 1-2:
# [x] Set CRON_SECRET
# [x] Set HETZNER_REDIS_URL + PASSWORD
# [ ] Test locally: http://localhost:3000/api/cron/update-news
# [ ] Deploy to Vercel
# [ ] Setup Hetzner cron (see route.ts comments)
# [ ] Monitor logs: /var/log/allhalal-cron.log

# Week 3+ (optional):
# [ ] Add DEEPSEEK_API_KEY for AI summaries
# [ ] Test AI integration locally
# [ ] Deploy and monitor costs

# ============================================
# NOTES
# ============================================
# - If both Hetzner and Upstash are set, Hetzner is used (priority)
# - If neither is set, falls back to in-memory cache (no persistence)
# - Memory cache is reset on every Vercel deployment
# - Redis cache survives deployments and is shared across serverless instances
