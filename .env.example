# ============================================
# AllHalal.info Environment Variables
# ============================================
# Copy this to .env.local for development
# Add these to Vercel for production

# ============================================
# HETZNER API (БЕСПЛАТНО - используем свой сервер)
# ============================================
# URL вашего Hetzner FastAPI бэкенда
# Продакшн: https://api.allhalal.info
# Разработка: http://localhost:8000
NEXT_PUBLIC_API_URL=https://api.allhalal.info

# Optional: base URL for editorial custom articles (no trailing slash).
# Default: https://api.allhalal.info/api/v1/custom
# CUSTOM_ARTICLES_API_BASE=https://api.allhalal.info/api/v1/custom

# Admin UI: /en/admin/custom-articles (see docs/CUSTOM_ARTICLES_WRITE_API.md)
# ADMIN_CUSTOM_DASHBOARD_PASSWORD=long-random-password
# ADMIN_CUSTOM_SESSION_SECRET=long-random-secret-for-cookie-hmac
# CUSTOM_ARTICLES_WRITE_TOKEN=same-bearer-secret-as-fastapi-validates

# Briefs JSON (home/feed/categories/detail): defaults to {NEXT_PUBLIC_API_URL}/api/v1/briefs
# Set explicitly if briefs must hit a different host than NEXT_PUBLIC_API_URL (debug prod vs stage).
# NEXT_PUBLIC_BRIEFS_API_BASE=https://api.allhalal.info/api/v1/briefs

# ============================================
# ЧТО НАСТРОЕНО НА HETZNER (не нужны токены!)
# ============================================
# ✅ Redis работает в Docker (локально, бесплатно)
# ✅ FastAPI endpoint: /api/v1/news/cached
# ✅ Python RSS parser обновляет Redis каждые 30 минут
# ✅ Все на одном сервере = быстро и бесплатно

# ============================================
# SETUP CHECKLIST (для Cursor агента)
# ============================================
# На Hetzner сервере:
# [x] Redis работает в Docker
# [ ] Создать /root/allhalal_news_updater.py
# [ ] Установить: pip3 install feedparser redis requests
# [ ] Добавить FastAPI endpoint: /api/v1/news/cached
# [ ] Настроить cron: */30 * * * * python3 /root/allhalal_news_updater.py
# [ ] Проверить логи: /var/log/allhalal-news.log

# На Vercel:
# [ ] Добавить NEXT_PUBLIC_API_URL=https://api.allhalal.info
# [ ] Задеплоить обновленный код

# ============================================
# ИНСТРУКЦИИ ДЛЯ CURSOR АГЕНТА
# ============================================
# Читай: /docs/CURSOR-AGENT-INSTRUCTIONS.md
# Там полные инструкции по настройке бэкенда

# ============================================
# ПРИМЕЧАНИЯ
# ============================================
# - Нет платных сервисов (Upstash не нужен!)
# - Нет внешних API ключей
# - Все работает на вашем Hetzner сервере
# - Next.js получает данные через HTTPS API (быстро, безопасно)
# - ISR кеширование в Next.js: 30 минут
# - Hetzner обновляет кеш каждые 30 минут
# - Если Hetzner API недоступен → fallback на прямой RSS парсинг

# ============================================
# БЕЗОПАСНОСТЬ
# ============================================
# ✅ Redis закрыт внутри сервера (только localhost)
# ✅ FastAPI доступен через HTTPS (с вашим SSL сертификатом)
# ✅ Никаких открытых портов Redis
# ✅ Никаких токенов в публичном коде

# ============================================
# ADSENSE (WEB MONETIZATION)
# ============================================
# Enable only after AdSense approval
NEXT_PUBLIC_ENABLE_ADSENSE_SLOTS=false

# Publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-5317347727083675

# Ad unit slot IDs (create these in AdSense when ready)
NEXT_PUBLIC_ADSENSE_SLOT_NEWS_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_NEWS_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_NEWS_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_INLINE=

# ============================================
# INDEXNOW API (INSTANT SEARCH ENGINE INDEXING)
# ============================================
# IndexNow instantly notifies search engines about new/updated pages
# Free API supported by Google, Bing, Yandex
# Generate a random UUID for your key: https://www.uuidgenerator.net/

# Your IndexNow API key (UUID format)
# Example: 47e04c4c8f2b4e5a8e4c8f2b4e5a8e4c
INDEXNOW_KEY=

# Optional: Secret token to protect the /api/index-now endpoint
# Leave empty to allow public access (not recommended for production)
INDEXNOW_API_SECRET=
